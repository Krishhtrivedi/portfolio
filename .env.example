# ==============================================================================
# KRISH TRIVEDI PORTFOLIO (https://krishtrivedi.in) — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Email Delivery via EmailJS (Recommended for Static Sites)
# 1. Create a free account at https://www.emailjs.com/
# 2. Add an Email Service (e.g. Gmail / Resend / SendGrid)
# 3. Create an Email Template with variables: {{from_name}}, {{from_email}}, {{subject}}, {{message}}
# 4. Copy your Service ID, Template ID, and Public Key below:
EMAILJS_SERVICE_ID=service_portfolio
EMAILJS_TEMPLATE_ID=template_contact
EMAILJS_PUBLIC_KEY=your_public_key_here

# Alternative Custom Webhook / Formspree Endpoint (Optional fallback)
# If set, form dispatches JSON payload { name, email, subject, message }
# CONTACT_ENDPOINT=https://formspree.io/f/your_form_id

# Canonical Domain URL
SITE_URL=https://krishtrivedi.in
