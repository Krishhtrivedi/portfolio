# ==============================================================================
# KRISH TRIVEDI PORTFOLIO (https://krishtrivedi.in) — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Primary Static Delivery: EmailJS (Client-Side Safe Delivery)
# 1. Sign up for a free account at https://www.emailjs.com/
# 2. Connect your email service provider (Gmail / Outlook / Resend / SendGrid)
# 3. Create an email template mapping: {{from_name}}, {{from_email}}, {{subject}}, {{message}}
# 4. Fill in your credentials below:
EMAILJS_SERVICE_ID=service_portfolio
EMAILJS_TEMPLATE_ID=template_contact
EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Secondary / Self-Hosted Webhook Endpoint (Optional fallback)
# Dispatches standard POST JSON payload: { name, email, subject, message }
# CONTACT_ENDPOINT=https://formspree.io/f/your_form_id

# Backend Serverless Function Option (e.g., Next.js API / Cloudflare Worker / Express)
# RESEND_API_KEY=re_123456789_abcdef
# CONTACT_NOTIFICATION_EMAIL=krish.trivedi28@gmail.com

# Production Canonical Domain
SITE_URL=https://krishtrivedi.in
